      "favicon": "./assets/icon.png",
      "name": "Mealio",
      "shortName": "Mealio",
      "themeColor": "#2D6A4F",
      "backgroundColor": "#F7F4EF",
      "lang": "de"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
